          "primary-900": "42 85% 10%",
          "primary-950": "42 85% 7%",
          "primary-foreground": "223 50% 10%",
          "secondary": "210 40% 94%",
          "secondary-foreground": "223 50% 10%",
          "muted": "210 40% 94%",
          "muted-foreground": "215 16% 40%",
