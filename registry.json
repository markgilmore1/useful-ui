    {
      "name": "foundation",
      "type": "registry:style",
      "description": "Design tokens (light + dark), Tailwind theme extensions, and core utilities. Add this first.",
      "dependencies": [
        "clsx",
        "tailwind-merge",
        "tailwindcss-animate"
      ],
      "files": [
        {
          "path": "src/lib/utils.ts",
          "type": "registry:lib"
        },
        {
          "path": "src/lib/formatters.ts",
          "type": "registry:lib"
        }
      ],
      "cssVars": {
        "theme": {
          "--radius": "0.5rem"
        },
        "light": {
          "background": "210 40% 98%",
          "foreground": "223 50% 10%",
          "card": "0 0% 100%",
