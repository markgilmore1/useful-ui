          "primary-100": "42 85% 90%",
          "primary-200": "42 85% 80%",
          "primary-300": "42 85% 70%",
          "primary-400": "42 85% 60%",
          "primary-500": "42 85% 50%",
          "primary-600": "42 85% 40%",
          "primary-700": "42 85% 30%",
          "primary-800": "42 85% 20%",
          "primary-900": "42 85% 10%",
          "primary-950": "42 85% 7%",
          "primary-foreground": "223 50% 7%",
          "secondary": "220 45% 12%",
          "secondary-foreground": "210 40% 98%",
          "muted": "220 45% 12%",
          "muted-foreground": "215 20% 65%",
          "accent": "42 85% 60%",
          "accent-foreground": "223 50% 7%",
          "destructive": "0 62% 50%",
          "destructive-foreground": "210 40% 98%",
          "success": "142 71% 45%",
          "success-foreground": "223 50% 7%",
          "warning": "38 80% 50%",
          "warning-foreground": "223 50% 7%",
