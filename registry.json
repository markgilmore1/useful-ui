          "sidebar-background": "223 50% 7%",
          "sidebar-foreground": "215 20% 65%",
          "sidebar-primary": "199 89% 48%",
          "sidebar-primary-foreground": "223 50% 7%",
          "sidebar-accent": "220 45% 12%",
          "sidebar-accent-foreground": "210 40% 98%",
